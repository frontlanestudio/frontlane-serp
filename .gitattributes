# Auto-detect text files and normalize line endings to LF
* text=auto eol=lf

# Source code & syntax diff drivers
*.rs text eol=lf diff=rust
*.py text eol=lf diff=python
*.js text eol=lf
*.ts text eol=lf
*.tsx text eol=lf
*.css text eol=lf
*.html text eol=lf
*.sql text eol=lf
*.sh text eol=lf

# Structured configuration & data
*.toml text eol=lf
*.yaml text eol=lf
*.yml text eol=lf
*.json text eol=lf
*.csv text eol=lf
*.tsv text eol=lf
*.md text eol=lf
Makefile text eol=lf
Dockerfile text eol=lf
LICENSE text eol=lf

# Windows scripts
*.bat text eol=crlf
*.cmd text eol=crlf
*.ps1 text eol=crlf

# Binary formats (prevent CRLF line normalization & binary diff corruption)
*.png binary
*.jpg binary
*.jpeg binary
*.gif binary
*.ico binary
*.webp binary
*.avif binary
*.wasm binary
*.pdf binary
*.zip binary
*.tar binary
*.tar.gz binary
*.tgz binary
*.gz binary
*.7z binary
*.db binary
*.sqlite binary
*.sqlite3 binary
*.parquet binary
*.woff binary
*.woff2 binary
*.ttf binary
*.eot binary

# Vector graphics
*.svg text eol=lf

# GitHub Linguist settings
Cargo.lock text eol=lf linguist-generated=true
tests/fixtures/** linguist-vendored=true
tests/fixtures/** -diff
docs/** linguist-documentation
